# ─────────── SECRETS — never commit ───────────
**/.env
.env
*.env
!*.env.example

# ─────────── Airflow runtime data + logs (GBs) ───────────
automation/data/
automation/logs/

# ─────────── Python ───────────
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─────────── Vector store local data ───────────
vector_store/qdrant_data/
vector_store/hf-cache/
vector_store/*.bin

# ─────────── OS / editor ───────────
.DS_Store
*.swp
*~

# ─────────── Belt-and-suspenders: never commit bulk data anywhere ───────────
# (scrape/ also has its own allowlist .gitignore blocking its 17 GB of data)
*.jsonl
*.ndjson
*.zip
*.parquet
*.sqlite
*.db
# raw docs pulled by scrapers (they live in S3, not git)
**/pdfs/
**/*.pdf
# ...except our own documentation, which is generated from the code and belongs
# with it. The rule above is aimed at scraped source documents.
!graph/GRAPH_TECHNICAL.pdf
!graph/DATA_SOURCES.pdf

# Personal permission rules; contains machine-specific absolute paths
.claude/settings.local.json

# Graph build output. Each run is ~2.1 GB of CSVs and is fully derived from
# S3 - regenerable by `build.py --all`, so it is never worth versioning. Left
# untracked by hand until now, which held only because files were added by
# name; one `git add -A` on a build host would have committed the lot.
graph/build/
graph/final*/
graph/runs/
graph/import/
graph/*.log

# Private keys. graph_sync needs an SSH key readable inside the Airflow
# container, and the only already-mounted writable path is automation/config -
# so without this rule, putting it there would commit a private key to a repo
# that gets pushed to GitHub.
*.pem
*.key
*.p12
id_rsa*

# Test pipeline secrets: Groq key, Neo4j password.
testPipeline/.env
