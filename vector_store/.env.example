# Copy to vector_store/.env on the host and fill in. Never committed.
# config.py calls load_dotenv(), so this is picked up by the API, by ingest.py
# run by hand, and by the Airflow DAG over SSH - one file, all entry points.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
