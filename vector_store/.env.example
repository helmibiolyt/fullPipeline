# Copy to .env and fill in.
# --- S3 (moine-data — same bucket the scraper writes to) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=moine-data

# --- Qdrant ---
# Default = EMBEDDED (no Docker): vectors stored in this local folder.
QDRANT_PATH=./qdrant_data
# To use a Qdrant SERVER instead (Docker/Cloud), set QDRANT_URL and it takes over:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=biolyt_docs

# --- Models (defaults are fine) ---
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_FP16=1
